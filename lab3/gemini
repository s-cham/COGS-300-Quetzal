// =========================
// MOTOR PINS
// =========================
const int IN1 = 8;
const int IN2 = 7;
const int IN3 = 12;
const int IN4 = 13;
const int ENA = 9;    // RIGHT motor
const int ENB = 11;   // LEFT motor

// =========================
// ULTRASONIC PINS
// =========================
const int frontTrig = 3;
const int frontEcho = 4;
const int sideTrig  = 6;    // faces RIGHT
const int sideEcho  = 2;

// =========================
// SETTINGS
// =========================
const int leftSpeed  = 100;
const int rightSpeed = 90;
const int pivotSpeed = 90;    // Balanced speed to avoid violent over-spinning
const int minSteerSpeed = 40; // Floor to prevent motor stall in dead zone

// =========================
// CONTROL CONSTANTS
// =========================
const float Kp = 3.5;                 // Proportional gain for wall following
const float targetWallDist = 15.0;    // Target distance from the right wall in cm
const float frontObstacleThresh = 30.0; // Early reaction threshold for inside corners

void setup() {
  // Motor pin modes
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);

  // Ultrasonic pin modes
  pinMode(frontTrig, OUTPUT);
  pinMode(frontEcho, INPUT);
  pinMode(sideTrig, OUTPUT);
  pinMode(sideEcho, INPUT);

  Serial.begin(9600);
}

void loop() {
  float frontDist = getDistance(frontTrig, frontEcho);
  float sideDist = getDistance(sideTrig, sideEcho);

  // Debugging output
  Serial.print("Front: "); Serial.print(frontDist);
  Serial.print(" cm | Side: "); Serial.println(sideDist);

  // 1. INSIDE CORNER CASE: Obstacle directly ahead
  if (frontDist > 0 && frontDist < frontObstacleThresh) {
    // Quick reverse brake pulse to kill forward momentum
    brakeRobot();
    delay(80);

    // Controlled left turn until the front is clear
    unsigned long turnStartTime = millis();
    while (frontDist < frontObstacleThresh + 10.0) {
      turnLeft(pivotSpeed);
      delay(30);
      frontDist = getDistance(frontTrig, frontEcho);
      
      // Safety timeout to prevent infinite loops if sensor drops a reading
      if (millis() - turnStartTime > 600) {
        break; 
      }
    }
    
    stopRobot();
    delay(150);
  }
  // 2. OUTSIDE CORNER CASE: Wall suddenly drops away / lost on the right
  else if (sideDist > 40.0 || sideDist == 0) {
    // Drive forward slightly past the corner edge
    moveRobot(rightSpeed, leftSpeed);
    delay(250); 

    // Smooth arc right to sweep and find the new wall
    unsigned long searchStartTime = millis();
    while (millis() - searchStartTime < 600) {
      float currentSide = getDistance(sideTrig, sideEcho);
      if (currentSide > 0 && currentSide < 35.0) {
        break; // Found the wall, exit search mode
      }
      moveRobot(rightSpeed * 0.7, leftSpeed * 1.2); 
      delay(30);
    }
  }
  // 3. NORMAL WALL FOLLOWING: P-Controller
  else {
    // error = measurement - set_point
    float error = sideDist - targetWallDist; 
    float correction = Kp * error;

    // Adjust motor speeds dynamically based on error
    int rSpd = rightSpeed - correction;
    int lSpd = leftSpeed + correction;

    // Constrain to acceptable motor speeds and minSteerSpeed floor
    rSpd = constrain(rSpd, minSteerSpeed, 255);
    lSpd = constrain(lSpd, minSteerSpeed, 255);

    moveRobot(rSpd, lSpd);
  }

  delay(25);
}

// Helper function to measure distance with a hardware dead-zone safety clamp
float getDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 20000); // 20ms timeout (~30cm limit)
  if (duration == 0) return 40.0; // Return max cap if timeout
  
  float dist = duration * 0.034 / 2.0;

  // HC-SR04 acoustic ringing dead-zone filter (< 5cm false inflation fix)
  if (dist < 5.0) {
    return 5.0; 
  }
  return dist;
}

// Drive both motors forward at specified speeds
void moveRobot(int rSpd, int lSpd) {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  analogWrite(ENA, rSpd);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  analogWrite(ENB, lSpd);
}

// Pivot in place (Left motor back, Right motor forward)
void turnLeft(int spd) {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  analogWrite(ENA, spd);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  analogWrite(ENB, spd);
}

// Active brief reverse pulse to kill forward momentum
void brakeRobot() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  analogWrite(ENA, 80);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  analogWrite(ENB, 80);
}

// Stop all motion
void stopRobot() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  analogWrite(ENA, 0);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  analogWrite(ENB, 0);
}
