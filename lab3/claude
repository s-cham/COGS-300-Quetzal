// =========================
// MOTOR PINS
// =========================

const int IN1 = 8;
const int IN2 = 7;
const int IN3 = 12;
const int IN4 = 13;

const int ENA = 9;
const int ENB = 11;


// =========================
// ULTRASONIC SENSOR PINS
// =========================

// Front HC-SR04
const int frontTrig = 3;
const int frontEcho = 4;

// Side HC-SR04
const int sideTrig = 6;
const int sideEcho = 2;


// =========================
// WALL FOLLOWING SETTINGS
// =========================

const float targetDistance = 25.0;
const float Kp = 2.5;

const int baseSpeed = 170;
const int minSpeed = 115;
const int maxSpeed = 225;

const float frontStopDistance = 15.0;


// Wall on RIGHT
const bool wallOnRight = true;

// ENA controls LEFT motor
const bool enaIsLeft = true;


// =========================
// SENSOR FILTERING
// =========================

float filteredSide = 25.0;
bool firstReading = true;

float lastValidSide = -1;

int invalidSideCount = 0;
const int maxInvalidSideReadings = 5;


// =========================
// READ ULTRASONIC DISTANCE
// =========================

float readDistance(int trig, int echo) {

  digitalWrite(trig, LOW);
  delayMicroseconds(2);

  digitalWrite(trig, HIGH);
  delayMicroseconds(10);

  digitalWrite(trig, LOW);

  long duration = pulseIn(echo, HIGH, 25000);

  // No echo received
  if (duration == 0) {
    return -1;
  }

  float distance = duration * 0.0343 / 2.0;

  // Reject unreasonable readings
  if (distance < 2 || distance > 350) {
    return -1;
  }

  return distance;
}


// =========================
// MOTOR CONTROL
// =========================

void motors(int leftSpeed, int rightSpeed) {

  // Keep values between -255 and 255
  leftSpeed = constrain(leftSpeed, -255, 255);
  rightSpeed = constrain(rightSpeed, -255, 255);


  // Determine which speed goes to which L298N channel

  int speedA;
  int speedB;

  if (enaIsLeft) {
    speedA = leftSpeed;
    speedB = rightSpeed;
  } 
  else {
    speedA = rightSpeed;
    speedB = leftSpeed;
  }


  // =========================
  // LEFT / CHANNEL A
  // =========================

  if (speedA > 0) {

    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);

  } 
  else if (speedA < 0) {

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);

  } 
  else {

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
  }


  // =========================
  // RIGHT / CHANNEL B
  // =========================

  if (speedB > 0) {

    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);

  } 
  else if (speedB < 0) {

    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);

  } 
  else {

    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);
  }


  // PWM speed
  analogWrite(ENA, abs(speedA));
  analogWrite(ENB, abs(speedB));
}


// =========================
// SETUP
// =========================

void setup() {

  Serial.begin(9600);


  // Motor pins
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);


  // Front sensor
  pinMode(frontTrig, OUTPUT);
  pinMode(frontEcho, INPUT);


  // Side sensor
  pinMode(sideTrig, OUTPUT);
  pinMode(sideEcho, INPUT);


  // Make sure motors start stopped
  motors(0, 0);

  delay(1000);

  Serial.println("Wall Following Ready!");
}


// =========================
// MAIN LOOP
// =========================

void loop() {

  // =========================
  // READ FRONT SENSOR
  // =========================

  float front = readDistance(frontTrig, frontEcho);

  delay(60);


  // =========================
  // READ SIDE SENSOR
  // =========================

  float side = readDistance(sideTrig, sideEcho);


  // =========================
  // PRINT SENSOR READINGS
  // =========================

  Serial.print("Front: ");
  Serial.print(front);

  Serial.print(" cm | Side: ");
  Serial.print(side);

  Serial.println(" cm");


  // =========================
  // FRONT OBSTACLE
  // =========================

  if (front >= 2 && front < frontStopDistance) {

    Serial.println("Obstacle ahead - turning");


    // Wall on right:
    // turn LEFT to avoid obstacle

    if (wallOnRight) {

      motors(-150, 150);

    } 
    else {

      motors(150, -150);
    }


    delay(100);

    return;
  }


  // =========================
  // SIDE SENSOR
  // =========================

  if (side >= 2 && side <= 150) {

    // Valid reading

    invalidSideCount = 0;

    lastValidSide = side;


    // =========================
    // SMOOTH SENSOR READING
    // =========================

    if (firstReading) {

      filteredSide = side;
      firstReading = false;

    } 
    else {

      filteredSide =
        0.6 * filteredSide +
        0.4 * side;
    }

  } 
  else {

    // =========================
    // INVALID READING
    // =========================

    invalidSideCount++;

    Serial.println("Invalid side reading");


    // If we have a previous valid reading,
    // keep using it temporarily

    if (lastValidSide > 0) {

      filteredSide = lastValidSide;

    } 
    else {

      // No useful reading yet
      motors(0, 0);

      Serial.println("No side reading - STOP");

      delay(100);

      return;
    }


    // Stop if sensor keeps failing

    if (invalidSideCount >= maxInvalidSideReadings) {

      motors(0, 0);

      Serial.println("Too many invalid readings - STOP");

      delay(100);

      return;
    }
  }


  // =========================
  // P-CONTROLLER
  // =========================

  float error = filteredSide - targetDistance;

  float correction = Kp * error;


  // Prevent correction from becoming too large

  correction = constrain(correction, -55, 55);


  // =========================
  // CALCULATE MOTOR SPEEDS
  // =========================

  int leftSpeed;
  int rightSpeed;


  if (wallOnRight) {

    leftSpeed = baseSpeed + correction;
    rightSpeed = baseSpeed - correction;

  } 
  else {

    leftSpeed = baseSpeed - correction;
    rightSpeed = baseSpeed + correction;
  }


  // Keep motors within safe speed range

  leftSpeed = constrain(
    leftSpeed,
    minSpeed,
    maxSpeed
  );

  rightSpeed = constrain(
    rightSpeed,
    minSpeed,
    maxSpeed
  );


  // =========================
  // DRIVE
  // =========================

  motors(leftSpeed, rightSpeed);


  // =========================
  // DEBUG INFORMATION
  // =========================

  Serial.print("Filtered Side: ");
  Serial.print(filteredSide);

  Serial.print(" | Error: ");
  Serial.print(error);

  Serial.print(" | Correction: ");
  Serial.print(correction);

  Serial.print(" | Left PWM: ");
  Serial.print(leftSpeed);

  Serial.print(" | Right PWM: ");
  Serial.println(rightSpeed);


  delay(100);
}
