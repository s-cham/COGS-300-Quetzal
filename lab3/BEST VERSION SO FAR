
const int IN1 = 8;
const int IN2 = 7;
const int IN3 = 12;
const int IN4 = 13;

const int ENA = 9;   // RIGHT motor
const int ENB = 11;  // LEFT motor

// =====================
// ULTRASONIC SENSORS
// =====================
const int frontTrig = 3;
const int frontEcho = 4;
const int rightTrig = 6;
const int rightEcho = 2;

// =====================
// MOTOR SPEEDS
// =====================
const int leftSpeed = 100;
const int rightSpeed = 90;

const int turnSpeed = 130;

// =====================
// DISTANCE SETTINGS (cm)
// =====================
const float frontStopDistance = 15.0;
const float rightTargetDistance = 10.0;

// Minimum right clearance for a right turn
const float rightClearDistance = 20.0;

const float maxWallDistance = 60.0;

// No steering correction between 8 and 12 cm
const float deadZone = 2.0;

// =====================
// P-CONTROLLER
// =====================
const float Kp = 2.0;

// Maximum motor-speed correction
const int maxCorrection = 20;

// =====================
// TIMING (ms)
// =====================
const int reverseTime = 300;
const int turnTime = 400;

// =====================
// READ ULTRASONIC DISTANCE
// =====================
float readDistance(int trig, int echo) {

  digitalWrite(trig, LOW);
  delayMicroseconds(2);

  digitalWrite(trig, HIGH);
  delayMicroseconds(10);
  digitalWrite(trig, LOW);

  unsigned long duration =
    pulseIn(echo, HIGH, 15000UL);

  if (duration == 0) return -1;

  float distance = duration * 0.0343 / 2.0;

  if (distance < 2 || distance > 250) {
    return -1;
  }

  return distance;
}

// =====================
// MOTOR CONTROL
// =====================
void motor(int in1, int in2, int en, int speed) {

  speed = constrain(speed, -255, 255);

  digitalWrite(in1, speed > 0 ? HIGH : LOW);
  digitalWrite(in2, speed < 0 ? HIGH : LOW);

  analogWrite(en, abs(speed));
}

void drive(int left, int right) {

  // ENA controls RIGHT motor
  motor(IN1, IN2, ENA, right);

  // ENB controls LEFT motor
  motor(IN3, IN4, ENB, left);
}

void stopCar() {
  drive(0, 0);
}

// =====================
// AVOID FRONT OBSTACLE
// =====================
void avoidObstacle() {

  Serial.println("Obstacle ahead!");

  // Step 1: Reverse
  drive(-leftSpeed, -rightSpeed);
  delay(reverseTime);

  stopCar();
  delay(50);

  // Step 2: Check right side
  float right =
    readDistance(rightTrig, rightEcho);

  // Step 3: Choose direction
  if (right >= rightClearDistance) {

    Serial.println("Turning RIGHT");

    drive(turnSpeed, -turnSpeed);

  } else {

    Serial.println("Turning LEFT");

    drive(-turnSpeed, turnSpeed);
  }

  // Step 4: Complete turn
  delay(turnTime);

  stopCar();
  delay(50);
}

// =====================
// SETUP
// =====================
void setup() {

  Serial.begin(9600);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);

  pinMode(frontTrig, OUTPUT);
  pinMode(frontEcho, INPUT);

  pinMode(rightTrig, OUTPUT);
  pinMode(rightEcho, INPUT);

  digitalWrite(frontTrig, LOW);
  digitalWrite(rightTrig, LOW);

  stopCar();

  delay(1000);

  Serial.println("Robot Ready!");
}

// =====================
// MAIN LOOP
// =====================
void loop() {

  // Read front sensor first
  float front =
    readDistance(frontTrig, frontEcho);

  delay(20);

  // Read right sensor
  float right =
    readDistance(rightTrig, rightEcho);

  Serial.print("Front: ");
  Serial.print(front);

  Serial.print(" | Right: ");
  Serial.println(right);

  // =====================
  // 1. FRONT OBSTACLE
  // =====================

  // Stop if front reading is invalid
  if (front < 0) {

    stopCar();
    delay(30);
    return;
  }

  // Front obstacle has highest priority
  if (front < frontStopDistance) {

    avoidObstacle();
    return;
  }

  // =====================
  // 2. RIGHT WALL FOLLOWING
  // =====================

  int left = leftSpeed;
  int rightMotor = rightSpeed;

  if (right >= 2 && right <= maxWallDistance) {

    // Positive error = too far from wall
    // Negative error = too close to wall
    float error =
      right - rightTargetDistance;

    // Ignore small errors
    if (abs(error) <= deadZone) {
      error = 0;
    }

    // Proportional correction
    int correction = constrain(
      (int)(Kp * abs(error)),
      0,
      maxCorrection
    );

    if (error < 0) {

      // TOO CLOSE: steer LEFT
      left = leftSpeed - correction;

      Serial.println("Adjusting LEFT");

    } else if (error > 0) {

      // TOO FAR: steer RIGHT
      rightMotor = rightSpeed - correction;

      Serial.println("Adjusting RIGHT");

    } else {

      // At target distance: drive straight
      left = leftSpeed;
      rightMotor = rightSpeed;

      Serial.println("Driving STRAIGHT");
    }

  } else {

    // No reliable right wall reading
    left = leftSpeed;
    rightMotor = rightSpeed;

    Serial.println("No right wall - straight");
  }

  // =====================
  // 3. DRIVE FORWARD
  // =====================
  drive(left, rightMotor);

  delay(10);
}
